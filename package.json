{
  "name": "homebrew-vault",
  "version": "1.0.0",
  "description": "Track homebrew D&D spells, magic items and monsters. Import them from webpages, filter them, delete them.",
  "main": "server.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^4.22.3"
  }
}
