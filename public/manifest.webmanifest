{
  "name": "Homebrew Vault",
  "short_name": "Homebrew",
  "description": "Track homebrew D&D spells, magic items and monsters. Import them from webpages, filter, and delete.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f1e7",
  "theme_color": "#8a1c1c",
  "categories": ["games", "utilities", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Import", "url": "./#import", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "DM Screen", "url": "./#screen", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
